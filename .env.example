# Copie ce fichier en .env.local puis colle tes clés après le signe =
# (.env.local n'est jamais envoyé sur GitHub)

# Token reçu par mail après inscription sur https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Clé créée sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# true = l'app utilise uniquement les données enregistrées dans data/demo (utile si le wifi tombe)
DEMO_MODE=false
